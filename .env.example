# Copy to .env (git-ignored) and replace every placeholder. Never commit real values.

# PostgreSQL password used by docker-compose for both the database and the application.
POSTGRES_PASSWORD=change-me-local-db-password

# Single operator account for the web UI and the HTTP Basic API.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-admin-password

# Optional AWS Cost Explorer integration (disabled by default).
# Credentials are NOT configured here: the AWS SDK default provider chain is used
# (for example AWS_PROFILE with a mounted ~/.aws directory, or an IAM role on AWS).
COSTPLATFORM_AWS_ENABLED=false
COSTPLATFORM_AWS_ENVIRONMENT_TAG_KEY=Environment
# AWS_PROFILE=your-profile-name
